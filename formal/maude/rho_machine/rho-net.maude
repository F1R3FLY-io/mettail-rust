--- Generated from formal/process/rho_comm_slice.json.
--- Executable rewrite-logic projection for a finite RhoNet COMM
--- fragment with internal RSpace-style reserve/commit phases.

mod RHO-NET-COMM is
  protecting BOOL .

  sorts Fact State .
  subsort Fact < State .

  ops a b c d reservedA reservedB reservedC reservedD firedA firedB firedC firedD reservedJoin completed : -> Fact [ctor] .
  op empty : -> State [ctor] .
  op __ : State State -> State [ctor assoc comm id: empty] .

  rl [reserveA] : a => reservedA .
  rl [fireA] : reservedA => firedA .
  rl [reserveB] : b => reservedB .
  rl [fireB] : reservedB => firedB .
  rl [reserveC] : c => reservedC .
  rl [fireC] : reservedC => firedC .
  rl [reserveD] : d => reservedD .
  rl [fireD] : reservedD => firedD .
  rl [reserveJoin] : firedA firedB firedC firedD => reservedJoin .
  rl [complete] : reservedJoin => completed .
endm

mod RHO-NET-COMM-TRACED is
  protecting BOOL .

  sorts Fact State Trace Step Config .
  subsort Fact < State .

  ops a b c d reservedA reservedB reservedC reservedD firedA firedB firedC firedD reservedJoin completed : -> Fact [ctor] .
  ops fireA fireB fireC fireD complete : -> Step [ctor] .
  op empty : -> State [ctor] .
  op __ : State State -> State [ctor assoc comm id: empty] .
  op nil : -> Trace [ctor] .
  op _then_ : Trace Step -> Trace [ctor] .
  op <_;_> : State Trace -> Config [ctor] .

  var REST : State .
  var T : Trace .

  rl [reserveATraced] : < a REST ; T > => < reservedA REST ; T > .
  rl [fireATraced] : < reservedA REST ; T > => < firedA REST ; T then fireA > .
  rl [reserveBTraced] : < b REST ; T > => < reservedB REST ; T > .
  rl [fireBTraced] : < reservedB REST ; T > => < firedB REST ; T then fireB > .
  rl [reserveCTraced] : < c REST ; T > => < reservedC REST ; T > .
  rl [fireCTraced] : < reservedC REST ; T > => < firedC REST ; T then fireC > .
  rl [reserveDTraced] : < d REST ; T > => < reservedD REST ; T > .
  rl [fireDTraced] : < reservedD REST ; T > => < firedD REST ; T then fireD > .
  rl [reserveJoinTraced] : < firedA firedB firedC firedD REST ; T > => < reservedJoin REST ; T > .
  rl [completeTraced] : < reservedJoin REST ; T > => < completed REST ; T then complete > .
endm

mod RHO-GUARDED-JOIN is
  protecting BOOL .

  sorts Fact State .
  subsort Fact < State .

  ops gl gbad gok guardOpen rejectedGuard completedGuard reservedGuardBad reservedGuardGood : -> Fact [ctor] .
  op empty : -> State [ctor] .
  op __ : State State -> State [ctor assoc comm id: empty] .

  rl [reserveGuardBad] : gl gbad guardOpen => reservedGuardBad .
  rl [guardReject] : reservedGuardBad => gl gbad rejectedGuard .
  rl [reserveGuardGood] : gl gok => reservedGuardGood .
  rl [guardCommit] : reservedGuardGood => completedGuard .
endm

