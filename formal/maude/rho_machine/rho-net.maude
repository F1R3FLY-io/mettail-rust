  rl [reserveGuardBadTraced] : < gl gbad guardOpen REST ; T > => < reservedGuardBad REST ; T > .
  rl [guardRejectTraced] : < reservedGuardBad REST ; T > => < gl gbad rejectedGuard REST ; T then guardReject > .
  rl [reserveGuardGoodTraced] : < gl gok REST ; T > => < reservedGuardGood REST ; T > .
