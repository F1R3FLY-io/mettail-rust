% Generated from formal/process/rho_comm_slice.json.
% Finite RhoNet COMM projection with internal RSpace-style reserve/commit
% phases.
%
% Each independent redex first reserves its matching channel datum
% internally and only then exposes the visible commit. Completion
% likewise has an internal join reservation before the visible
% `complete` observation. The matching Dovetail projection in
% dovetail_fact_steps.mcrl2 performs direct visible fact steps.
% The Makefile compares the two LTSs by branching bisimulation while
% treating reserve actions as internal tau steps.

act
  reserveA, reserveB, reserveC, reserveD, reserveJoin, fireA, fireB, fireC, fireD, complete, done;

proc
  RhoNet(
    aIn: Bool,
    bIn: Bool,
    cIn: Bool,
    dIn: Bool,
    aReserved: Bool,
    bReserved: Bool,
    cReserved: Bool,
    dReserved: Bool,
    aOut: Bool,
    bOut: Bool,
    cOut: Bool,
    dOut: Bool,
    joinReserved: Bool,
    completed: Bool
  ) =
       (aIn && !aReserved && !aOut && !completed)
         -> reserveA . RhoNet(false, bIn, cIn, dIn, true, bReserved, cReserved, dReserved, aOut, bOut, cOut, dOut, joinReserved, completed)
     + (aReserved && !completed)
         -> fireA . RhoNet(aIn, bIn, cIn, dIn, false, bReserved, cReserved, dReserved, true, bOut, cOut, dOut, joinReserved, completed)
     + (bIn && !bReserved && !bOut && !completed)
         -> reserveB . RhoNet(aIn, false, cIn, dIn, aReserved, true, cReserved, dReserved, aOut, bOut, cOut, dOut, joinReserved, completed)
     + (bReserved && !completed)
         -> fireB . RhoNet(aIn, bIn, cIn, dIn, aReserved, false, cReserved, dReserved, aOut, true, cOut, dOut, joinReserved, completed)
     + (cIn && !cReserved && !cOut && !completed)
         -> reserveC . RhoNet(aIn, bIn, false, dIn, aReserved, bReserved, true, dReserved, aOut, bOut, cOut, dOut, joinReserved, completed)
     + (cReserved && !completed)
         -> fireC . RhoNet(aIn, bIn, cIn, dIn, aReserved, bReserved, false, dReserved, aOut, bOut, true, dOut, joinReserved, completed)
     + (dIn && !dReserved && !dOut && !completed)
         -> reserveD . RhoNet(aIn, bIn, cIn, false, aReserved, bReserved, cReserved, true, aOut, bOut, cOut, dOut, joinReserved, completed)
     + (dReserved && !completed)
         -> fireD . RhoNet(aIn, bIn, cIn, dIn, aReserved, bReserved, cReserved, false, aOut, bOut, cOut, true, joinReserved, completed)
     + (aOut && bOut && cOut && dOut && !joinReserved && !completed)
         -> reserveJoin . RhoNet(aIn, bIn, cIn, dIn, aReserved, bReserved, cReserved, dReserved, false, false, false, false, true, completed)
     + (joinReserved && !completed)
         -> complete . RhoNet(aIn, bIn, cIn, dIn, aReserved, bReserved, cReserved, dReserved, aOut, bOut, cOut, dOut, false, true)
     + completed
         -> done . RhoNet(aIn, bIn, cIn, dIn, aReserved, bReserved, cReserved, dReserved, aOut, bOut, cOut, dOut, joinReserved, true);

init
  RhoNet(true, true, true, true, false, false, false, false, false, false, false, false, false, false);
