# Cap-enforcing wrapper. The sibling Makefile is generated by coq_makefile
# and may be regenerated, so do not put policy there.

FORMAL_CAPPED_TARGET_HINT := rocq-rule-consolidation
FORMAL_CLEAN_GOALS := clean cleanall archclean
include ../../capped.mk

.DEFAULT_GOAL := all

.PHONY: all clean cleanall archclean

SANITIZE_GENERATED_MAKEFILE = sed -i '/\# FI[X]ME:/d' Makefile

GNUmakefile Makefile.local CoqMakefile.local ../../capped.mk:
	@:

all:
	$(MAKE) -f Makefile
	$(SANITIZE_GENERATED_MAKEFILE)

clean cleanall archclean:
	$(MAKE) -f Makefile $@

%:
	$(MAKE) -f Makefile $@
	$(SANITIZE_GENERATED_MAKEFILE)
