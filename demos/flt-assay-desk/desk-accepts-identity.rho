// ════════════════════════════════════════════════════════════════════════════════════════════
//  THE ASSAY DESK, SAME SET, DIFFERENT PREDICATE — the guard is what chooses.
//
//  Run me with the RhoCalc interpreter:
//    target/debug/rhocalc demos/flt-assay-desk/desk-accepts-identity.rho
//
//  This file is `desk-accepts-constant.rho` with ONE token changed: the term on the right of
//  the `==` in the `where` clause. The three resting results are identical, the receive pattern
//  is identical, the channel is identical.
//
//        desk-accepts-constant.rho    where lam`${r}` == lam`lam a. lam b. a`   ⟹  ⟦λ.λ.1⟧
//        desk-accepts-identity.rho    where lam`${r}` == lam`lam x. x`          ⟹  ⟦λ.0⟧
//
//  RUN BOTH AND COMPARE. Two things follow, and neither is arguable:
//    1. the guard is genuinely DECIDED, not failing closed. A guard the substrate could not
//       decide would reject everything, and this file would publish nothing;
//    2. ⟦λ.0⟧ was still resting on @"assay" all along in the previous run. The desk selected
//       out of the resting set; it did not consume it.
//
//  EXPECT
//  ──────
//        @"OUT"  =  ⟦λ.0⟧                         contract A's result — the identity combinator
//        left behind on @"assay": ⟦λ.λ.0⟧ and ⟦λ.λ.1⟧
// ════════════════════════════════════════════════════════════════════════════════════════════

@"assay"!(lam`lam x. x`) |
@"assay"!(lam`lam a. lam b. b`) |
@"assay"!(lam`lam a. lam b. a`) |

for(@lam`${r}` <- @"assay" where lam`${r}` == lam`lam x. x`) {
  @"OUT"!(lam`${r}`)
}
