new install(`rho:mettail:install`), observe(`rho:mettail:flt:observe`), stdout(`rho:io:stdout`) in {
  new loaded, handlePipe in {
    install!(
Module RegexGSLT {
  Theory Regex() {
    Data({
      "types": [
        "Pattern", "Computation", "NFrames", "DFrames", "EFrames",
        "MatchResult", "ReplacementTemplate", "PrefixResult",
        {"name":"Scalar", "carrier":"String", "admits_variables":true},
        {"name":"Text", "carrier":"String", "admits_variables":true},
        {"name":"Bool", "carrier":"bool", "admits_variables":false},
        {"name":"Flag", "carrier":"bool", "admits_variables":false},
        {"name":"Nat", "carrier":"BigInt", "admits_variables":false},
        {"name":"Grade", "carrier":"BigInt", "admits_variables":false}
      ],
      "literals": [
        {"category":"Scalar", "pattern":"[A-Za-z0-9\\u{80}-\\u{10FFFF}]", "eval":["carrier", "str", Map()]},
        {"category":"Nat", "pattern":"[0-9]+", "eval":["carrier", "int", Map()]}
      ]
    })
    Terms {
      PFail . |- "(?!)" : Pattern;
      PEpsilon . |- "()" : Pattern;
      PAny . |- "." : Pattern;
      PLiteral . scalar:Scalar |- scalar : Pattern;
      PGroup . body:Pattern |- "(" body ")" : Pattern;
      BFalse . |- "false" : Bool;
      BTrue . |- "true" : Bool;
      CallNullable . p:Pattern |- "nullable(" p ")" : Computation;
      CallDerivative . c:Scalar, p:Pattern |- "derivative(" c "," p ")" : Computation;
      DoneBool . b:Bool |- "doneBool(" b ")" : Computation;
      DonePattern . p:Pattern |- "donePattern(" p ")" : Computation;

      CallFullMatch . p:Pattern, t:Text |- "fullMatch(" p "," t ")" : Computation;
      CallSearch . p:Pattern, t:Text |- "search(" p "," t ")" : Computation;
      CallReplaceFirst . p:Pattern, r:ReplacementTemplate, t:Text |- "replaceFirst(" p "," r "," t ")" : Computation;
      CallReplaceAll . p:Pattern, r:ReplacementTemplate, t:Text |- "replaceAll(" p "," r "," t ")" : Computation;
      DoneMatch . m:MatchResult |- "doneMatch(" m ")" : Computation;
      DoneText . t:Text |- "doneText(" t ")" : Computation;
      NoMatch . |- "noMatch" : MatchResult;
      MatchFound . start:Nat, end:Nat, text:Text |- "found(" start "," end "," text ")" : MatchResult;
      ReplacementEmpty . |- "empty" : ReplacementTemplate;
      ReplacementLiteral . t:Text |- "literal(" t ")" : ReplacementTemplate;
      ReplacementWhole . |- "whole" : ReplacementTemplate;
      ReplacementAppend . l:ReplacementTemplate, r:ReplacementTemplate |- "append(" l "," r ")" : ReplacementTemplate;
      PrefixNone . |- "prefixNone" : PrefixResult;
      PrefixSome . end:Nat |- "prefixSome(" end ")" : PrefixResult;
      FullSurface . sub:Computation, t:Text |- "fullSurface(" sub "," t ")" : Computation;
      FullScan . p:Pattern, t:Text, i:Nat |- "fullScan(" p "," t "," i ")" : Computation;
      FullAtEnd . b:Flag, p:Pattern, t:Text, i:Nat |- "fullAtEnd(" b "," p "," t "," i ")" : Computation;
      FullDerivative . sub:Computation, t:Text, i:Nat |- "fullDerivative(" sub "," t "," i ")" : Computation;
      FullNullable . sub:Computation |- "fullNullable(" sub ")" : Computation;
      SearchSurface . sub:Computation, t:Text |- "searchSurface(" sub "," t ")" : Computation;
      SearchEmit . sub:Computation |- "searchEmit(" sub ")" : Computation;
      SearchScan . p:Pattern, t:Text, i:Nat |- "searchScan(" p "," t "," i ")" : Computation;
      SearchPrefix . sub:Computation, p:Pattern, t:Text, i:Nat |- "searchPrefix(" sub "," p "," t "," i ")" : Computation;
      SearchAtEnd . b:Flag, p:Pattern, t:Text, i:Nat, end:Nat |- "searchAtEnd(" b "," p "," t "," i "," end ")" : Computation;
      SearchDone . result:MatchResult, end:Nat |- "searchDone(" result "," end ")" : Computation;
      PrefixScan . p:Pattern, t:Text, i:Nat |- "prefixScan(" p "," t "," i ")" : Computation;
      PrefixAtEnd . b:Flag, p:Pattern, t:Text, i:Nat |- "prefixAtEnd(" b "," p "," t "," i ")" : Computation;
      PrefixDerivative . sub:Computation, p:Pattern, t:Text, i:Nat, next:Nat |- "prefixDerivative(" sub "," p "," t "," i "," next ")" : Computation;
      PrefixUnwind . sub:Computation, p:Pattern, t:Text, i:Nat |- "prefixUnwind(" sub "," p "," t "," i ")" : Computation;
      PrefixNullable . sub:Computation, i:Nat, end:Nat |- "prefixNullable(" sub "," i "," end ")" : Computation;
      PrefixDone . result:PrefixResult, end:Nat |- "prefixDone(" result "," end ")" : Computation;
      ReplaceSurface . sub:Computation, r:ReplacementTemplate, t:Text, all:Bool |- "replaceSurface(" sub "," r "," t "," all ")" : Computation;
      ReplaceCompute . p:Pattern, r:ReplacementTemplate, t:Text, all:Bool |- "replaceCompute(" p "," r "," t "," all ")" : Computation;
      ReplaceSearch . sub:Computation, p:Pattern, r:ReplacementTemplate, t:Text, all:Bool |- "replaceSearch(" sub "," p "," r "," t "," all ")" : Computation;
      RenderEval . r:ReplacementTemplate, matched:Text |- "renderEval(" r "," matched ")" : Computation;
      RenderLeft . sub:Computation, r:ReplacementTemplate, matched:Text |- "renderLeft(" sub "," r "," matched ")" : Computation;
      RenderRight . left:Text, sub:Computation |- "renderRight(" left "," sub ")" : Computation;
      RenderJoining . sub:Computation |- "renderJoining(" sub ")" : Computation;
      RenderDone . t:Text |- "renderDone(" t ")" : Computation;
      ReplaceRender . sub:Computation, p:Pattern, r:ReplacementTemplate, t:Text, all:Bool, start:Nat, end:Nat, total:Nat |- "replaceRender(" sub "," p "," r "," t "," all "," start "," end "," total ")" : Computation;
      ReplaceSplice . p:Pattern, r:ReplacementTemplate, t:Text, all:Bool, start:Nat, end:Nat, total:Nat, inserted:Text, zero:Nat |- "replaceSplice(" p "," r "," t "," all "," start "," end "," total "," inserted "," zero ")" : Computation;
      ReplaceProgress . empty:Flag, p:Pattern, r:ReplacementTemplate, t:Text, end:Nat, total:Nat, prefix:Text, inserted:Text |- "replaceProgress(" empty "," p "," r "," t "," end "," total "," prefix "," inserted ")" : Computation;
      ReplaceEmptyEnd . done:Flag, p:Pattern, r:ReplacementTemplate, t:Text, end:Nat, total:Nat, prefix:Text, inserted:Text |- "replaceEmptyEnd(" done "," p "," r "," t "," end "," total "," prefix "," inserted ")" : Computation;
      ReplaceJoin . prefix:Text, inserted:Text, sub:Computation |- "replaceJoin(" prefix "," inserted "," sub ")" : Computation;
      ReplaceJoinEmpty . prefix:Text, inserted:Text, copied:Text, sub:Computation |- "replaceJoinEmpty(" prefix "," inserted "," copied "," sub ")" : Computation;
      JoinPieces . pieces:List(Text) |- "joinPieces(" "[" pieces.*sep(",") "]" ")" : Computation;

      SAlt . p:Pattern, q:Pattern |- "smartAlt(" p "," q ")" : Computation;
      SAltRight . p:Pattern, q:Pattern |- "smartAltRight(" p "," q ")" : Computation;
      SAltEqual . p:Pattern, q:Pattern |- "smartAltEqual(" p "," q ")" : Computation;
      SAltDecide . b:Flag, p:Pattern, q:Pattern |- "smartAltDecide(" b "," p "," q ")" : Computation;
      SConcat . p:Pattern, q:Pattern |- "smartConcat(" p "," q ")" : Computation;
      SConcatRight . p:Pattern, q:Pattern |- "smartConcatRight(" p "," q ")" : Computation;
      SStar . p:Pattern |- "smartStar(" p ")" : Computation;
      SDone . p:Pattern |- "smartDone(" p ")" : Computation;

      NNil . |- "nNil" : NFrames;
      NAltLeft . p:Pattern, k:NFrames |- "nAltLeft(" p "," k ")" : NFrames;
      NAltRight . b:Bool, k:NFrames |- "nAltRight(" b "," k ")" : NFrames;
      NConcatLeft . p:Pattern, k:NFrames |- "nConcatLeft(" p "," k ")" : NFrames;
      NConcatRight . b:Bool, k:NFrames |- "nConcatRight(" b "," k ")" : NFrames;
      NEval . p:Pattern, k:NFrames |- "nEval(" p "," k ")" : Computation;
      NReturn . b:Bool, k:NFrames |- "nReturn(" b "," k ")" : Computation;
      NDone . b:Bool |- "nDone(" b ")" : Computation;

      DNil . |- "dNil" : DFrames;
      DAltLeft . c:Scalar, q:Pattern, k:DFrames |- "dAltLeft(" c "," q "," k ")" : DFrames;
      DAltRight . p:Pattern, k:DFrames |- "dAltRight(" p "," k ")" : DFrames;
      DConcatLeft . c:Scalar, p:Pattern, q:Pattern, k:DFrames |- "dConcatLeft(" c "," p "," q "," k ")" : DFrames;
      DConcatProduct . c:Scalar, p:Pattern, q:Pattern, k:DFrames |- "dConcatProduct(" c "," p "," q "," k ")" : DFrames;
      DConcatRight . p:Pattern, k:DFrames |- "dConcatRight(" p "," k ")" : DFrames;
      DStarBody . p:Pattern, k:DFrames |- "dStarBody(" p "," k ")" : DFrames;
      DStarFactor . p:Pattern, k:DFrames |- "dStarFactor(" p "," k ")" : DFrames;
      DEval . c:Scalar, p:Pattern, k:DFrames |- "dEval(" c "," p "," k ")" : Computation;
      DCompare . c:Scalar, d:Scalar, k:DFrames |- "dCompare(" c "," d "," k ")" : Computation;
      DDecide . b:Flag, k:DFrames |- "dDecide(" b "," k ")" : Computation;
      DReturn . p:Pattern, k:DFrames |- "dReturn(" p "," k ")" : Computation;
      DNullable . sub:Computation, c:Scalar, q:Pattern, p:Pattern, k:DFrames |- "dNullable(" sub "," c "," q "," p "," k ")" : Computation;
      DSmart . sub:Computation, k:DFrames |- "dSmart(" sub "," k ")" : Computation;
      DDone . p:Pattern |- "dDone(" p ")" : Computation;

      ENil . |- "eNil" : EFrames;
      EAltLeft . p:Pattern, k:EFrames |- "eAltLeft(" p "," k ")" : EFrames;
      EAltRight . p:Pattern, k:EFrames |- "eAltRight(" p "," k ")" : EFrames;
      EConcatLeft . p:Pattern, k:EFrames |- "eConcatLeft(" p "," k ")" : EFrames;
      EConcatRight . p:Pattern, k:EFrames |- "eConcatRight(" p "," k ")" : EFrames;
      EStar . k:EFrames |- "eStar(" k ")" : EFrames;
      EPlus . k:EFrames |- "ePlus(" k ")" : EFrames;
      EPlusFactor . p:Pattern, k:EFrames |- "ePlusFactor(" p "," k ")" : EFrames;
      EOptional . k:EFrames |- "eOptional(" k ")" : EFrames;
      ERepeat . lo:Nat, hi:Nat, k:EFrames |- "eRepeat(" lo "," hi "," k ")" : EFrames;
      EEval . p:Pattern, k:EFrames |- "eEval(" p "," k ")" : Computation;
      EReturn . p:Pattern, k:EFrames |- "eReturn(" p "," k ")" : Computation;
      ESmart . sub:Computation, k:EFrames |- "eSmart(" sub "," k ")" : Computation;
      ERepeating . sub:Computation, k:EFrames |- "eRepeating(" sub "," k ")" : Computation;
      EDone . p:Pattern |- "eDone(" p ")" : Computation;
      EScalar . c:Scalar, k:EFrames |- "eScalar(" c "," k ")" : Computation;
      EReadScalar . c:Scalar, zero:Nat, k:EFrames |- "eReadScalar(" c "," zero "," k ")" : Computation;
      EScalarDecide . b:Flag, c:Scalar, k:EFrames |- "eScalarDecide(" b "," c "," k ")" : Computation;

      RInit . p:Pattern, lo:Nat, hi:Nat |- "rInit(" p "," lo "," hi ")" : Computation;
      RBounds . p:Pattern, lo:Nat, hi:Nat, zero:Nat, one:Nat |- "rBounds(" p "," lo "," hi "," zero "," one ")" : Computation;
      RRequired . p:Pattern, lo:Nat, hi:Nat, i:Nat, one:Nat, acc:Pattern |- "rRequired(" p "," lo "," hi "," i "," one "," acc ")" : Computation;
      RAtLower . b:Flag, p:Pattern, lo:Nat, hi:Nat, i:Nat, one:Nat, acc:Pattern |- "rAtLower(" b "," p "," lo "," hi "," i "," one "," acc ")" : Computation;
      RCheckUpper . p:Pattern, lo:Nat, hi:Nat, i:Nat, one:Nat, acc:Pattern |- "rCheckUpper(" p "," lo "," hi "," i "," one "," acc ")" : Computation;
      RAtUpper . b:Flag, p:Pattern, lo:Nat, hi:Nat, i:Nat, one:Nat, acc:Pattern |- "rAtUpper(" b "," p "," lo "," hi "," i "," one "," acc ")" : Computation;
      RAppend . p:Pattern, lo:Nat, hi:Nat, i:Nat, one:Nat, sub:Computation |- "rAppend(" p "," lo "," hi "," i "," one "," sub ")" : Computation;
      ROptional . p:Pattern, hi:Nat, i:Nat, one:Nat, req:Pattern, acc:Pattern |- "rOptional(" p "," hi "," i "," one "," req "," acc ")" : Computation;
      ROptionalAtUpper . b:Flag, p:Pattern, hi:Nat, i:Nat, one:Nat, req:Pattern, acc:Pattern |- "rOptionalAtUpper(" b "," p "," hi "," i "," one "," req "," acc ")" : Computation;
      RProduct . p:Pattern, hi:Nat, i:Nat, one:Nat, req:Pattern, sub:Computation |- "rProduct(" p "," hi "," i "," one "," req "," sub ")" : Computation;
      RAlternative . p:Pattern, hi:Nat, i:Nat, one:Nat, req:Pattern, sub:Computation |- "rAlternative(" p "," hi "," i "," one "," req "," sub ")" : Computation;
      RFinish . sub:Computation |- "rFinish(" sub ")" : Computation;
      RDone . p:Pattern |- "rDone(" p ")" : Computation;

      NullableSurface . sub:Computation |- "nullableSurface(" sub ")" : Computation;
      NullableCore . sub:Computation |- "nullableCore(" sub ")" : Computation;
      DerivativeScalar . c:Scalar, p:Pattern |- "derivativeScalar(" c "," p ")" : Computation;
      DerivativeReadScalar . c:Scalar, p:Pattern, zero:Nat |- "derivativeReadScalar(" c "," p "," zero ")" : Computation;
      DerivativeScalarDecide . b:Flag, c:Scalar, p:Pattern |- "derivativeScalarDecide(" b "," c "," p ")" : Computation;
      DerivativeSurface . c:Scalar, sub:Computation |- "derivativeSurface(" c "," sub ")" : Computation;
      DerivativeCore . sub:Computation |- "derivativeCore(" sub ")" : Computation;
    }
    Data({
      "terms": [
        {"label":"PAlt", "category":"Pattern", "context":[["param","p","Pattern"],["param","q","Pattern"]], "syntax":["p",["lit","|"],"q"], "assoc":"left", "prefix_bp":10},
        {"label":"PConcat", "category":"Pattern", "context":[["param","p","Pattern"],["param","q","Pattern"]], "syntax":["p","q"], "assoc":"left", "prefix_bp":20},
        {"label":"PStar", "category":"Pattern", "context":[["param","p","Pattern"]], "syntax":["p",["lit","*"]], "assoc":"nonassoc", "prefix_bp":30},
        {"label":"PPlus", "category":"Pattern", "context":[["param","p","Pattern"]], "syntax":["p",["lit","+"]], "assoc":"nonassoc", "prefix_bp":30},
        {"label":"POptional", "category":"Pattern", "context":[["param","p","Pattern"]], "syntax":["p",["lit","?"]], "assoc":"nonassoc", "prefix_bp":30},
        {"label":"PRepeat", "category":"Pattern", "context":[["param","p","Pattern"],["param","lo","Nat"],["param","hi","Nat"]], "syntax":["p",["lit","{"],"lo",["lit",","],"hi",["lit","}"]], "assoc":"nonassoc", "prefix_bp":30}
      ]
    })
    Equations {
      (PAlt (PFail) P) == P;
      (PAlt P (PFail)) == P;
      (PAlt P P) == P;
      (PConcat (PFail) P) == (PFail);
      (PConcat P (PFail)) == (PFail);
      (PConcat (PEpsilon) P) == P;
      (PConcat P (PEpsilon)) == P;
      (PStar (PFail)) == (PEpsilon);
      (PStar (PEpsilon)) == (PEpsilon);
      (PStar (PStar P)) == (PStar P);
    }
    Rewrites {
      StartNullable : (CallNullable P) ~> (NullableSurface (EEval P (ENil)));
      StartDerivative : (CallDerivative C P) ~> (DerivativeScalar C P);
      NullableSurfaceStep : if S ~> T then (NullableSurface S) ~> (NullableSurface T);
      NullableSurfaceDone : (NullableSurface (EDone P)) ~> (NullableCore (NEval P (NNil)));
      NullableCoreStep : if S ~> T then (NullableCore S) ~> (NullableCore T);
      NullableCoreDone : (NullableCore (NDone B)) ~> (DoneBool B);
      DerivativeSurfaceStep : if S ~> T then (DerivativeSurface C S) ~> (DerivativeSurface C T);
      DerivativeSurfaceDone : (DerivativeSurface C (EDone P)) ~> (DerivativeCore (DEval C P (DNil)));
      DerivativeCoreStep : if S ~> T then (DerivativeCore S) ~> (DerivativeCore T);
      DerivativeCoreDone : (DerivativeCore (DDone P)) ~> (DonePattern P);

      StartFullMatch : (CallFullMatch P T) ~> (FullSurface (EEval P (ENil)) T);
      FullDerivativeDone : (FullDerivative (DDone P) T I) ~> (FullScan P T I);
      FullNullableDone : (FullNullable (NDone B)) ~> (DoneBool B);
      StartSearch : (CallSearch P T) ~> (SearchSurface (EEval P (ENil)) T);
      SearchScanStart : (SearchScan P T I) ~> (SearchPrefix (PrefixScan P T I) P T I);
      SearchEmitDone : (SearchEmit (SearchDone M L)) ~> (DoneMatch M);
      PrefixDerivativeDone : (PrefixDerivative (DDone Q) P T I J) ~> (PrefixUnwind (PrefixScan Q T J) P T I);
      PrefixUnwindFound : (PrefixUnwind (PrefixDone (PrefixSome E) L) P T I) ~> (PrefixDone (PrefixSome E) L);
      PrefixUnwindMiss : (PrefixUnwind (PrefixDone (PrefixNone) L) P T I) ~> (PrefixNullable (NEval P (NNil)) I L);
      PrefixNullableTrue : (PrefixNullable (NDone (BTrue)) I L) ~> (PrefixDone (PrefixSome I) L);
      PrefixNullableFalse : (PrefixNullable (NDone (BFalse)) I L) ~> (PrefixDone (PrefixNone) L);
      StartReplaceFirst : (CallReplaceFirst P R T) ~> (ReplaceSurface (EEval P (ENil)) R T (BFalse));
      StartReplaceAll : (CallReplaceAll P R T) ~> (ReplaceSurface (EEval P (ENil)) R T (BTrue));
      ReplaceSurfaceDone : (ReplaceSurface (EDone P) R T A) ~> (ReplaceCompute P R T A);
      ReplaceSearchMiss : (ReplaceSearch (SearchDone (NoMatch) L) P R T A) ~> (DoneText T);
      ReplaceSearchFound : (ReplaceSearch (SearchDone (MatchFound I J M) L) P R T A) ~> (ReplaceRender (RenderEval R M) P R T A I J L);
      RenderLiteral : (RenderEval (ReplacementLiteral T) M) ~> (RenderDone T);
      RenderWhole : (RenderEval (ReplacementWhole) M) ~> (RenderDone M);
      RenderAppend : (RenderEval (ReplacementAppend L R) M) ~> (RenderLeft (RenderEval L M) R M);
      RenderLeftDone : (RenderLeft (RenderDone L) R M) ~> (RenderRight L (RenderEval R M));
      RenderJoiningDone : (RenderJoining (DoneText T)) ~> (RenderDone T);
      FullSurfaceStep : if S ~> U then (FullSurface S T) ~> (FullSurface U T);
      FullDerivativeStep : if S ~> U then (FullDerivative S T I) ~> (FullDerivative U T I);
      FullNullableStep : if S ~> U then (FullNullable S) ~> (FullNullable U);
      SearchSurfaceStep : if S ~> U then (SearchSurface S T) ~> (SearchSurface U T);
      SearchEmitStep : if S ~> U then (SearchEmit S) ~> (SearchEmit U);
      SearchPrefixStep : if S ~> U then (SearchPrefix S P T I) ~> (SearchPrefix U P T I);
      PrefixDerivativeStep : if S ~> U then (PrefixDerivative S P T I J) ~> (PrefixDerivative U P T I J);
      PrefixUnwindStep : if S ~> U then (PrefixUnwind S P T I) ~> (PrefixUnwind U P T I);
      PrefixNullableStep : if S ~> U then (PrefixNullable S I L) ~> (PrefixNullable U I L);
      ReplaceSurfaceStep : if S ~> U then (ReplaceSurface S R T A) ~> (ReplaceSurface U R T A);
      ReplaceSearchStep : if S ~> U then (ReplaceSearch S P R T A) ~> (ReplaceSearch U P R T A);
      RenderLeftStep : if S ~> U then (RenderLeft S R M) ~> (RenderLeft U R M);
      RenderRightStep : if S ~> U then (RenderRight L S) ~> (RenderRight L U);
      RenderJoiningStep : if S ~> U then (RenderJoining S) ~> (RenderJoining U);
      ReplaceRenderStep : if S ~> U then (ReplaceRender S P R T A I J L) ~> (ReplaceRender U P R T A I J L);
      ReplaceJoinStep : if S ~> U then (ReplaceJoin P I S) ~> (ReplaceJoin P I U);
      ReplaceJoinEmptyStep : if S ~> U then (ReplaceJoinEmpty P I C S) ~> (ReplaceJoinEmpty P I C U);

      SmartAltFail : (SAlt (PFail) Q) ~> (SDone Q);
      SmartAltEpsilon : (SAlt (PEpsilon) Q) ~> (SAltRight (PEpsilon) Q);
      SmartAltLiteral : (SAlt (PLiteral C) Q) ~> (SAltRight (PLiteral C) Q);
      SmartAltAny : (SAlt (PAny) Q) ~> (SAltRight (PAny) Q);
      SmartAltAlt : (SAlt (PAlt P R) Q) ~> (SAltRight (PAlt P R) Q);
      SmartAltConcat : (SAlt (PConcat P R) Q) ~> (SAltRight (PConcat P R) Q);
      SmartAltStar : (SAlt (PStar P) Q) ~> (SAltRight (PStar P) Q);
      SmartAltRightFail : (SAltRight P (PFail)) ~> (SDone P);
      SmartAltRightEpsilon : (SAltRight P (PEpsilon)) ~> (SAltEqual P (PEpsilon));
      SmartAltRightLiteral : (SAltRight P (PLiteral C)) ~> (SAltEqual P (PLiteral C));
      SmartAltRightAny : (SAltRight P (PAny)) ~> (SAltEqual P (PAny));
      SmartAltRightAlt : (SAltRight P (PAlt Q R)) ~> (SAltEqual P (PAlt Q R));
      SmartAltRightConcat : (SAltRight P (PConcat Q R)) ~> (SAltEqual P (PConcat Q R));
      SmartAltRightStar : (SAltRight P (PStar Q)) ~> (SAltEqual P (PStar Q));
      SmartConcatFail : (SConcat (PFail) Q) ~> (SDone (PFail));
      SmartConcatEpsilon : (SConcat (PEpsilon) Q) ~> (SDone Q);
      SmartConcatLiteral : (SConcat (PLiteral C) Q) ~> (SConcatRight (PLiteral C) Q);
      SmartConcatAny : (SConcat (PAny) Q) ~> (SConcatRight (PAny) Q);
      SmartConcatAlt : (SConcat (PAlt P R) Q) ~> (SConcatRight (PAlt P R) Q);
      SmartConcatConcat : (SConcat (PConcat P R) Q) ~> (SConcatRight (PConcat P R) Q);
      SmartConcatStar : (SConcat (PStar P) Q) ~> (SConcatRight (PStar P) Q);
      SmartConcatRightFail : (SConcatRight P (PFail)) ~> (SDone (PFail));
      SmartConcatRightEpsilon : (SConcatRight P (PEpsilon)) ~> (SDone P);
      SmartConcatRightLiteral : (SConcatRight P (PLiteral C)) ~> (SDone (PConcat P (PLiteral C)));
      SmartConcatRightAny : (SConcatRight P (PAny)) ~> (SDone (PConcat P (PAny)));
      SmartConcatRightAlt : (SConcatRight P (PAlt Q R)) ~> (SDone (PConcat P (PAlt Q R)));
      SmartConcatRightConcat : (SConcatRight P (PConcat Q R)) ~> (SDone (PConcat P (PConcat Q R)));
      SmartConcatRightStar : (SConcatRight P (PStar Q)) ~> (SDone (PConcat P (PStar Q)));
      SmartStarFail : (SStar (PFail)) ~> (SDone (PEpsilon));
      SmartStarEpsilon : (SStar (PEpsilon)) ~> (SDone (PEpsilon));
      SmartStarLiteral : (SStar (PLiteral C)) ~> (SDone (PStar (PLiteral C)));
      SmartStarAny : (SStar (PAny)) ~> (SDone (PStar (PAny)));
      SmartStarAlt : (SStar (PAlt P Q)) ~> (SDone (PStar (PAlt P Q)));
      SmartStarConcat : (SStar (PConcat P Q)) ~> (SDone (PStar (PConcat P Q)));
      SmartStarStar : (SStar (PStar P)) ~> (SDone (PStar P));

      NullableFail : (NEval (PFail) K) ~> (NReturn (BFalse) K);
      NullableEpsilon : (NEval (PEpsilon) K) ~> (NReturn (BTrue) K);
      NullableLiteral : (NEval (PLiteral C) K) ~> (NReturn (BFalse) K);
      NullableAny : (NEval (PAny) K) ~> (NReturn (BFalse) K);
      NullableStar : (NEval (PStar P) K) ~> (NReturn (BTrue) K);
      NullableAlt : (NEval (PAlt P Q) K) ~> (NEval P (NAltLeft Q K));
      NullableConcat : (NEval (PConcat P Q) K) ~> (NEval P (NConcatLeft Q K));
      NullableReturn : (NReturn B (NNil)) ~> (NDone B);
      NullableAltLeft : (NReturn B (NAltLeft Q K)) ~> (NEval Q (NAltRight B K));
      NullableAltFalse : (NReturn B (NAltRight (BFalse) K)) ~> (NReturn B K);
      NullableAltTrue : (NReturn B (NAltRight (BTrue) K)) ~> (NReturn (BTrue) K);
      NullableConcatLeft : (NReturn B (NConcatLeft Q K)) ~> (NEval Q (NConcatRight B K));
      NullableConcatFalse : (NReturn B (NConcatRight (BFalse) K)) ~> (NReturn (BFalse) K);
      NullableConcatTrue : (NReturn B (NConcatRight (BTrue) K)) ~> (NReturn B K);

      DerivativeFail : (DEval C (PFail) K) ~> (DReturn (PFail) K);
      DerivativeEpsilon : (DEval C (PEpsilon) K) ~> (DReturn (PFail) K);
      DerivativeLiteral : (DEval C (PLiteral D) K) ~> (DCompare C D K);
      DerivativeAny : (DEval C (PAny) K) ~> (DReturn (PEpsilon) K);
      DerivativeAlt : (DEval C (PAlt P Q) K) ~> (DEval C P (DAltLeft C Q K));
      DerivativeConcat : (DEval C (PConcat P Q) K) ~> (DEval C P (DConcatLeft C P Q K));
      DerivativeStar : (DEval C (PStar P) K) ~> (DEval C P (DStarBody P K));
      DerivativeReturn : (DReturn P (DNil)) ~> (DDone P);
      DerivativeAltLeft : (DReturn P (DAltLeft C Q K)) ~> (DEval C Q (DAltRight P K));
      DerivativeAltRight : (DReturn Q (DAltRight P K)) ~> (DSmart (SAlt P Q) K);
      DerivativeConcatLeft : (DReturn D (DConcatLeft C P Q K)) ~> (DSmart (SConcat D Q) (DConcatProduct C P Q K));
      DerivativeConcatProduct : (DReturn D (DConcatProduct C P Q K)) ~> (DNullable (NEval P (NNil)) C Q D K);
      DerivativeConcatRight : (DReturn D (DConcatRight P K)) ~> (DSmart (SAlt P D) K);
      DerivativeStarBody : (DReturn D (DStarBody P K)) ~> (DSmart (SStar P) (DStarFactor D K));
      DerivativeStarFactor : (DReturn P (DStarFactor D K)) ~> (DSmart (SConcat D P) K);
      DerivativeSmartStep : if S ~> T then (DSmart S K) ~> (DSmart T K);
      DerivativeSmartDone : (DSmart (SDone P) K) ~> (DReturn P K);
      DerivativeNullableStep : if S ~> T then (DNullable S C Q P K) ~> (DNullable T C Q P K);
      DerivativeNullableTrue : (DNullable (NDone (BTrue)) C Q P K) ~> (DEval C Q (DConcatRight P K));
      DerivativeNullableFalse : (DNullable (NDone (BFalse)) C Q P K) ~> (DReturn P K);

      ElaborateFail : (EEval (PFail) K) ~> (EReturn (PFail) K);
      ElaborateEpsilon : (EEval (PEpsilon) K) ~> (EReturn (PEpsilon) K);
      ElaborateLiteral : (EEval (PLiteral C) K) ~> (EScalar C K);
      ElaborateAny : (EEval (PAny) K) ~> (EReturn (PAny) K);
      ElaborateGroup : (EEval (PGroup P) K) ~> (EEval P K);
      ElaborateAlt : (EEval (PAlt P Q) K) ~> (EEval P (EAltLeft Q K));
      ElaborateConcat : (EEval (PConcat P Q) K) ~> (EEval P (EConcatLeft Q K));
      ElaborateStar : (EEval (PStar P) K) ~> (EEval P (EStar K));
      ElaboratePlus : (EEval (PPlus P) K) ~> (EEval P (EPlus K));
      ElaborateOptional : (EEval (POptional P) K) ~> (EEval P (EOptional K));
      ElaborateRepeat : (EEval (PRepeat P L U) K) ~> (EEval P (ERepeat L U K));
      ElaborateReturn : (EReturn P (ENil)) ~> (EDone P);
      ElaborateAltLeft : (EReturn P (EAltLeft Q K)) ~> (EEval Q (EAltRight P K));
      ElaborateAltRight : (EReturn Q (EAltRight P K)) ~> (ESmart (SAlt P Q) K);
      ElaborateConcatLeft : (EReturn P (EConcatLeft Q K)) ~> (EEval Q (EConcatRight P K));
      ElaborateConcatRight : (EReturn Q (EConcatRight P K)) ~> (ESmart (SConcat P Q) K);
      ElaborateStarReturn : (EReturn P (EStar K)) ~> (ESmart (SStar P) K);
      ElaboratePlusReturn : (EReturn P (EPlus K)) ~> (ESmart (SStar P) (EPlusFactor P K));
      ElaboratePlusFactor : (EReturn Q (EPlusFactor P K)) ~> (ESmart (SConcat P Q) K);
      ElaborateOptionalReturn : (EReturn P (EOptional K)) ~> (ESmart (SAlt (PEpsilon) P) K);
      ElaborateRepeatReturn : (EReturn P (ERepeat L U K)) ~> (ERepeating (RInit P L U) K);
      ElaborateSmartStep : if S ~> T then (ESmart S K) ~> (ESmart T K);
      ElaborateSmartDone : (ESmart (SDone P) K) ~> (EReturn P K);
      ElaborateRepeatStep : if S ~> T then (ERepeating S K) ~> (ERepeating T K);
      ElaborateRepeatDone : (ERepeating (RDone P) K) ~> (EReturn P K);

      RepeatAppendStep : if S ~> T then (RAppend P L U I O S) ~> (RAppend P L U I O T);
      RepeatProductStep : if S ~> T then (RProduct P U I O R S) ~> (RProduct P U I O R T);
      RepeatProductDone : (RProduct P U I O R (SDone A)) ~> (RAlternative P U I O R (SAlt (PEpsilon) A));
      RepeatAlternativeStep : if S ~> T then (RAlternative P U I O R S) ~> (RAlternative P U I O R T);
      RepeatFinishStep : if S ~> T then (RFinish S) ~> (RFinish T);
      RepeatFinishDone : (RFinish (SDone P)) ~> (RDone P);
