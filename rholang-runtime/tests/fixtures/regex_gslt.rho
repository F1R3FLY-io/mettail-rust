      StartDerivative : (CallDerivative C P) ~> (DerivativeScalar C P);
      NullableSurfaceStep : if S ~> T then (NullableSurface S) ~> (NullableSurface T);
      NullableSurfaceDone : (NullableSurface (EDone P)) ~> (NullableCore (NEval P (NNil)));
      NullableCoreStep : if S ~> T then (NullableCore S) ~> (NullableCore T);
      NullableCoreDone : (NullableCore (NDone B)) ~> (DoneBool B);
      DerivativeSurfaceStep : if S ~> T then (DerivativeSurface C S) ~> (DerivativeSurface C T);
      DerivativeSurfaceDone : (DerivativeSurface C (EDone P)) ~> (DerivativeCore (DEval C P (DNil)));
      DerivativeCoreStep : if S ~> T then (DerivativeCore S) ~> (DerivativeCore T);
      DerivativeCoreDone : (DerivativeCore (DDone P)) ~> (DonePattern P);

      SmartAltFail : (SAlt (PFail) Q) ~> (SDone Q);
      SmartAltEpsilon : (SAlt (PEpsilon) Q) ~> (SAltRight (PEpsilon) Q);
      SmartAltLiteral : (SAlt (PLiteral C) Q) ~> (SAltRight (PLiteral C) Q);
      SmartAltAny : (SAlt (PAny) Q) ~> (SAltRight (PAny) Q);
      SmartAltAlt : (SAlt (PAlt P R) Q) ~> (SAltRight (PAlt P R) Q);
      SmartAltConcat : (SAlt (PConcat P R) Q) ~> (SAltRight (PConcat P R) Q);
      SmartAltStar : (SAlt (PStar P) Q) ~> (SAltRight (PStar P) Q);
      SmartAltRightFail : (SAltRight P (PFail)) ~> (SDone P);
      SmartAltRightEpsilon : (SAltRight P (PEpsilon)) ~> (SAltEqual P (PEpsilon));
      SmartAltRightLiteral : (SAltRight P (PLiteral C)) ~> (SAltEqual P (PLiteral C));
      SmartAltRightAny : (SAltRight P (PAny)) ~> (SAltEqual P (PAny));
      SmartAltRightAlt : (SAltRight P (PAlt Q R)) ~> (SAltEqual P (PAlt Q R));
      SmartAltRightConcat : (SAltRight P (PConcat Q R)) ~> (SAltEqual P (PConcat Q R));
      SmartAltRightStar : (SAltRight P (PStar Q)) ~> (SAltEqual P (PStar Q));
      SmartConcatFail : (SConcat (PFail) Q) ~> (SDone (PFail));
      SmartConcatEpsilon : (SConcat (PEpsilon) Q) ~> (SDone Q);
      SmartConcatLiteral : (SConcat (PLiteral C) Q) ~> (SConcatRight (PLiteral C) Q);
      SmartConcatAny : (SConcat (PAny) Q) ~> (SConcatRight (PAny) Q);
      SmartConcatAlt : (SConcat (PAlt P R) Q) ~> (SConcatRight (PAlt P R) Q);
      SmartConcatConcat : (SConcat (PConcat P R) Q) ~> (SConcatRight (PConcat P R) Q);
      SmartConcatStar : (SConcat (PStar P) Q) ~> (SConcatRight (PStar P) Q);
      SmartConcatRightFail : (SConcatRight P (PFail)) ~> (SDone (PFail));
      SmartConcatRightEpsilon : (SConcatRight P (PEpsilon)) ~> (SDone P);
      SmartConcatRightLiteral : (SConcatRight P (PLiteral C)) ~> (SDone (PConcat P (PLiteral C)));
      SmartConcatRightAny : (SConcatRight P (PAny)) ~> (SDone (PConcat P (PAny)));
      SmartConcatRightAlt : (SConcatRight P (PAlt Q R)) ~> (SDone (PConcat P (PAlt Q R)));
      SmartConcatRightConcat : (SConcatRight P (PConcat Q R)) ~> (SDone (PConcat P (PConcat Q R)));
      SmartConcatRightStar : (SConcatRight P (PStar Q)) ~> (SDone (PConcat P (PStar Q)));
      SmartStarFail : (SStar (PFail)) ~> (SDone (PEpsilon));
      SmartStarEpsilon : (SStar (PEpsilon)) ~> (SDone (PEpsilon));
      SmartStarLiteral : (SStar (PLiteral C)) ~> (SDone (PStar (PLiteral C)));
      SmartStarAny : (SStar (PAny)) ~> (SDone (PStar (PAny)));
      SmartStarAlt : (SStar (PAlt P Q)) ~> (SDone (PStar (PAlt P Q)));
      SmartStarConcat : (SStar (PConcat P Q)) ~> (SDone (PStar (PConcat P Q)));
      SmartStarStar : (SStar (PStar P)) ~> (SDone (PStar P));

      NullableFail : (NEval (PFail) K) ~> (NReturn (BFalse) K);
      NullableEpsilon : (NEval (PEpsilon) K) ~> (NReturn (BTrue) K);
      NullableLiteral : (NEval (PLiteral C) K) ~> (NReturn (BFalse) K);
      NullableAny : (NEval (PAny) K) ~> (NReturn (BFalse) K);
      NullableStar : (NEval (PStar P) K) ~> (NReturn (BTrue) K);
      NullableAlt : (NEval (PAlt P Q) K) ~> (NEval P (NAltLeft Q K));
      NullableConcat : (NEval (PConcat P Q) K) ~> (NEval P (NConcatLeft Q K));
      NullableReturn : (NReturn B (NNil)) ~> (NDone B);
      NullableAltLeft : (NReturn B (NAltLeft Q K)) ~> (NEval Q (NAltRight B K));
      NullableAltFalse : (NReturn B (NAltRight (BFalse) K)) ~> (NReturn B K);
      NullableAltTrue : (NReturn B (NAltRight (BTrue) K)) ~> (NReturn (BTrue) K);
      NullableConcatLeft : (NReturn B (NConcatLeft Q K)) ~> (NEval Q (NConcatRight B K));
      NullableConcatFalse : (NReturn B (NConcatRight (BFalse) K)) ~> (NReturn (BFalse) K);
      NullableConcatTrue : (NReturn B (NConcatRight (BTrue) K)) ~> (NReturn B K);

      DerivativeFail : (DEval C (PFail) K) ~> (DReturn (PFail) K);
      DerivativeEpsilon : (DEval C (PEpsilon) K) ~> (DReturn (PFail) K);
      DerivativeLiteral : (DEval C (PLiteral D) K) ~> (DCompare C D K);
      DerivativeAny : (DEval C (PAny) K) ~> (DReturn (PEpsilon) K);
