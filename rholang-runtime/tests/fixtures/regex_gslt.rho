      ]
    })
    Equations {
      (PAlt (PFail) P) == P;
      (PAlt P (PFail)) == P;
      (PAlt P P) == P;
      (PConcat (PFail) P) == (PFail);
      (PConcat P (PFail)) == (PFail);
      (PConcat (PEpsilon) P) == P;
      (PConcat P (PEpsilon)) == P;
      (PStar (PFail)) == (PEpsilon);
      (PStar (PEpsilon)) == (PEpsilon);
      (PStar (PStar P)) == (PStar P);
