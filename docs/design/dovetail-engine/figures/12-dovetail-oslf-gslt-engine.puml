' Dovetail as the foundational OSLF/GSLT rewrite engine — ownership + artifact pipeline.
' Render: plantuml -tsvg 12-dovetail-oslf-gslt-engine.puml
@startuml
title Dovetail as the foundational OSLF/GSLT rewrite engine

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.2
skinparam componentStyle rectangle
skinparam rectangle {
  BorderColor #1F2937
  FontColor #111827
}

rectangle "language! · GSLT spec\n(syntax + equations + rewrites + folds + laws)" as GSLT #DBEAFE {
  rectangle "equations" as EQ #BFDBFE
  rectangle "rewrites" as RW #BFDBFE
  rectangle "folds\n(non-native output)" as FD #BFDBFE
  rectangle "operational laws" as OL #BFDBFE
}

rectangle "Macro lowering\n`dovetail_report.rs`\n→ typed-`L` e-graph" as LOWER #C7D2FE

rectangle "Dovetail core — OSLF-funded GSLT reduction" as CORE #EDE9FE {
  rectangle "saturation = GSLT reduction\ncongruence · AC · native-fold dispatch" as SAT #EDE9FE
  rectangle "OSLF funding\nrigail weights · max_nodes = Σ · is_funded · 1-best" as FUND #FEF3C7
}

rectangle "Result\nSatReport{Converged} + Extraction{Complete}\n→ DovetailRunReport" as RESULT #DCFCE7
rectangle "Rho backend\nrhoapi::Par → RSpace\n(host-routed COMM / new / PZero bypass folds)" as RHO #FCE7F3
rectangle "Refused\nNodeLimit ⇒ underfunded" as REF #FEE2E2

GSLT --> LOWER : LanguageDef inventory
LOWER --> CORE : equations + rewrites + folds\nas structural & native rules
CORE --> RESULT : saturate + funded 1-best extract
RESULT --> RHO : complete report only
CORE -[#DC2626]-> REF : Σ exhausted

legend bottom
  |= color |= concept |
  |<#DBEAFE>| GSLT syntax / terms |
  |<#FEF3C7>| OSLF funding (weight / budget / is_funded) |
  |<#EDE9FE>| engine mechanism (saturate / dispatch) |
  |<#DCFCE7>| reduced result / normal form |
  |<#FCE7F3>| Rho backend / host-routed |
  |<#FEE2E2>| refused / underfunded |
endlegend
@enduml
