@startuml
title Dovetail Lazy Best-First Extraction Frontier

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.3
skinparam activity {
  BorderColor #1F2937
  FontColor #111827
}

start
:Initialize class state; <<#DBEAFE>>
:Seed heap with zero-rank candidate\nfor each e-node; <<#DCFCE7>>
repeat
  :Pop best candidate by\n(weight, exact key); <<#FEF3C7>>
  :Generate successors by bumping\none child rank at a time; <<#FDE68A>>
  :Compose derivation tree; <<#EDE9FE>>
  if (cycle back-edge?) then (yes)
    :Mark cycle cut;\nskip this candidate; <<#FFEDD5>>
  elseif (weight is zero?) then (yes)
    :Treat as refuted;\nkeep successors available; <<#FEE2E2>>
  elseif (exact key already emitted?) then (yes)
    :Skip duplicate tree; <<#E5E7EB>>
  else (no)
    :Emit derivation item; <<#BBF7D0>>
  endif
repeat while (heap has candidates?) is (yes)
:Return Done(completeness); <<#FCE7F3>>
stop

legend right
|= Area |= Meaning |
|<#DBEAFE> State | class-local stream state |
|<#DCFCE7> Frontier | heap initialization |
|<#FEF3C7> Ordering | best-first pop key |
|<#FDE68A> Expansion | successor generation |
|<#BBF7D0> Emission | valid distinct derivation |
|<#FEE2E2> Refutation | zero-weight candidate |
|<#FFEDD5> Boundary | cycle-cut completeness marker |
endlegend
@enduml
