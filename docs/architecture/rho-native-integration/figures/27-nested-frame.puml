@startuml
' Figure 27-7: the NESTED (M2) descend-then-collapse frame for f(g(x)).
skinparam backgroundColor #FEFEFE
skinparam defaultFontName monospaced
skinparam shadowing false
skinparam rectangle {
  BorderColor #4A5568
  FontColor #1A202C
}
skinparam ArrowColor #4A5568
top to bottom direction

title Figure 27-7 — the NESTED (M2) frame  (f(g(x)) descend-then-collapse)

rectangle "for (_ <- loc:site0)\nmatch head tag => f" as ROOT #C6E0F5
rectangle "wrap_descent\nfor (h <- loc:site0/f.0){ match h => g }\ndescend the nested App head tag" as DESC #F6C177
rectangle "capture cap:site0/f.0/g.0\nthe collapsed subtree at the Var leaf" as CAP #D6C6EE
rectangle "sa:acc!(BoundVar(0), @OUT)\nM2 depth = recursion in collect_nested_schedule" as ACC #A7D8B6

ROOT --> DESC
DESC --> CAP
CAP --> ACC

note right of DESC #FCF3D0
  The root Match dispatches the head; wrap_descent consumes each
  nested App head tag on its loc: channel and dispatches on the
  ground op; the innermost Var leaves are captured on cap:.
end note
@enduml
