  rectangle "<b>T22  whole_gslt_in_rho_</b>\n<b>opcorrespondence</b>\n<size:10>(v) sound baseline</size>" as T22 #A7D8B6
  rectangle "<b>T23  whole_gslt_opcorr_</b>\n<b>over_optimal_matching</b>\n<size:10>(v) over O1-optimal</size>" as T23 #7FC79B
}

