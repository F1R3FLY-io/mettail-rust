  rectangle "T19 FBinderBeta\nweak_bisim_beta_cascade" as T19 #D6C6EE
}

package "the abstract finite-trace lift" #E1EFFA {
  rectangle "T21  finite_trace_barb_\nequivalence\n<size:10>R_barb / R_fwd / R_bwd</size>" as T21 #C6E0F5
}

