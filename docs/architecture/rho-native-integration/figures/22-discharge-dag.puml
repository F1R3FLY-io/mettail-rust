title Figure 22-1 — dependency graph of the argument:  (ii)+(viii) => (iii) => (v)\n(every node machine-checked)

package "Matching layer  (match-logic: gstep well-formedness + (iii) premises)" #EDF2F7 {
  rectangle "T2  positions_count\n<size:10>(ii) O1 symbol-once</size>" as T2 #CBD5E0
  rectangle "T3  tc_sound\n<size:10>(viii) tc(K) no cross-talk</size>" as T3 #CBD5E0
  rectangle "T1  sa_matches_positional\n<size:10>(i) match = positional</size>" as T1 #E2E8F0
  rectangle "T4  reuse_determinism\n<size:10>(x) tau-prefix</size>" as T4 #E2E8F0
  rectangle "T10 partial_consume_\nunreachable  <size:10>(iv)</size>" as T10 #E2E8F0
  rectangle "T9  eq_all_equal_commits\n<size:10>(vi) guard gates accept</size>" as T9 #E2E8F0
}

