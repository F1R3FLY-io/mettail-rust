@startuml
title Correctness Dependency Graph

skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam rectangle {
  BorderColor #1F2937
  FontColor #111827
}
skinparam ArrowColor #374151

rectangle "Language inventory\nand coverage" as Inventory #DBEAFE
rectangle "Exact-key\nidentity" as EK #BBF7D0
rectangle "Dovetail saturation\nsoundness" as DS #DCFCE7
rectangle "Dovetail saturation\ncompleteness" as DC #DCFCE7
rectangle "Checked extraction\nhonesty" as EH #CCFBF1
rectangle "RhoNet lowering\nsoundness" as RS #FEF3C7
rectangle "RhoNet lowering\ncompleteness" as RC #FEF3C7
rectangle "AST artifact\nexactness" as AE #FDE68A
rectangle "Guard atomicity" as GA #FDE68A
rectangle "RSpace COMM\nsemantics" as COMM #FBCFE8
rectangle "Parallel permutation\nindependence" as PI #FBCFE8
rectangle "Observation\ncorrectness" as OC #EDE9FE
rectangle "Rejected-rule\ncoverage contract" as RJ #FFEDD5
rectangle "Host Rho-machine\nreuse boundary" as HR #F3E8FF
rectangle "Flip gate\nevidence refs" as FG #DDD6FE
rectangle "Backend semantic\npreservation" as SP #FCE7F3

Inventory --> EK
Inventory --> DS
Inventory --> DC
Inventory --> RJ
EK --> DS
EK --> DC
DS --> EH
DC --> EH
DS --> RS
DC --> RC
EK --> RS
EK --> RC
EH --> RS
EH --> RC
GA --> RS
GA --> RC
RJ --> RC
RS --> AE
RC --> AE
AE --> COMM
GA --> COMM
COMM --> PI
PI --> OC
COMM --> OC
RS --> SP
RC --> SP
OC --> SP
HR --> SP
RJ --> FG
OC --> FG
SP --> FG

legend right
|= Area |= Meaning |
|<#DBEAFE> Inventory | language coverage inputs |
|<#DCFCE7> Dovetail | saturation facts and completeness |
|<#BBF7D0> Identity | exact-key preservation |
|<#CCFBF1> Extraction | honest complete or bounded reports |
|<#FEF3C7> Lowering | RhoNet correctness |
|<#FDE68A> Guards / AST | atomic guards and exact artifacts |
|<#FBCFE8> RSpace | COMM semantics and schedule independence |
|<#EDE9FE> Oracle | observation correctness |
|<#F3E8FF> Host | Rho-machine reuse boundary |
|<#DDD6FE> Gate | auditable runtime flip evidence |
|<#FCE7F3> Theorem | backend semantic preservation |
endlegend
@enduml
