@startuml
' Figure C: The col:/cap: collapse fold at a NON-NULLARY Var-leaf.
' Subject Swap(Pair(A,B), C) matched by pattern Swap(x, y): the variable x binds the
' non-nullary subterm Pair(A,B). The bottom-up fold republishes the fully collapsed
' ⟦Pair(A,B)⟧ on two DISJOINT channels — col: (read once by the parent chain) and
' cap: (read once by the automaton) — so x binds the WHOLE subtree, not its head tag.
skinparam backgroundColor #FEFEFE
skinparam defaultFontName sans
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor #555555
  LifeLineBorderColor #9A9A9A
  ParticipantBorderColor #7A7A7A
}

title col:/cap: Collapse Fold at a Non-Nullary Var-Leaf  (Swap(Pair(A,B), C) ▸ pattern Swap(x, y))

participant "leaf A\nspread @ indexed p3" as A #E8F0FE
participant "leaf B\nspread @ indexed p4" as B #E8F0FE
participant "Pair collapse receiver\nspread @ indexed p1" as P #E0F7F4
participant "automaton Var-leaf  x\n(state of pattern Swap(x, y))" as X #C9E7D4

== bottom-up collapse — children publish their chain (col:) values ==
A ->> P : col⟨ρ,p3⟩ ! ( ⟦A⟧ = EList[Ā] )
B ->> P : col⟨ρ,p4⟩ ! ( ⟦B⟧ = EList[B̲] )
activate P #E0F7F4
note over P #E0F7F4
  collapse_publish (internal node):
  for( v₀ ⟸ col⟨ρ,p3⟩ ; v₁ ⟸ col⟨ρ,p4⟩ )
  rebuild  ⟦Pair(A,B)⟧ = EList[ Pair̲, v₀, v₁ ]
  (byte-identical to reflect_ground_term_par)
end note

== republish the collapsed subterm on TWO disjoint channels ==
P ->> P : col⟨ρ,p1⟩ ! ( ⟦Pair(A,B)⟧ )
note left #E0F7F4: read ONCE by\nSwap's own parent fold\n(the chain)
P ->> X : cap⟨ρ,p1⟩ ! ( ⟦Pair(A,B)⟧ )
deactivate P
note right #C9E7D4: read ONCE by\nthe automaton\n(the capture)

== the Var-leaf binds the WHOLE subtree (M-collapse) ==
activate X #C9E7D4
X -> X : σ[x] := ⟦Pair(A,B)⟧
note over X #FDECEA
  M-collapse SOUNDNESS FIX.  Pre-fix, the leaf bound only the head
  tag ⇒  σ[x] = EList[Pair̲] = Pair()  — the children A, B were DROPPED,
  firing Pair(C, Pair()) instead of Pair(C, Pair(A,B)).
  FV: buggy_head_tag_wrong_for_nonnullary  (the arity-abstracted witness);
      sigma_rho_eq_pos  (in-Rho σ  ≡  positional σ, any depth).
end note
deactivate X

note across #EFEFEF
  Disjointness of col: and cap:  ⇒  the parent's chain read and the automaton's
  capture read NEVER race; each collapse value is consumed at most once (O1).
end note
@enduml
