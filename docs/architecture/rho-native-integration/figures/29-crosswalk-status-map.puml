}

package "sec:obligations — the nine obligations" #FDF0E0 {
  rectangle "ob:exist" as O1 #CBD5E0
  rectangle "ob:cohere" as O2 #CBD5E0
  rectangle "ob:opcorr\nfinite-trace form,\nover O1-optimal matching" as O3 #7FC79B
  rectangle "ob:classify" as O4 #CBD5E0
  rectangle "ob:barbed" as O5 #CBD5E0
  rectangle "ob:functor" as O6 #CBD5E0
  rectangle "ob:size" as O7 #CBD5E0
