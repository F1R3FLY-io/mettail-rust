rectangle "LEGEND\ndark green = mechanized + runtime-tested (8)\ngreen = mechanized (3)\ngrey = outside operational scope (29)\ntotal chips = 40" as LEG #FEFEFE

R2 -[hidden]down- L1
L13 -[hidden]down- A1
