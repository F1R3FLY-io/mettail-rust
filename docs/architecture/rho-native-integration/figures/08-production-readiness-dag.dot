digraph RuntimeBackendReadiness {
  graph [
    bgcolor="transparent",
    rankdir=LR,
    splines=ortho,
    pad=0.25,
    nodesep=0.55,
    ranksep=0.75
  ];

  node [
    shape=box,
    style="rounded,filled",
    color="#1F2937",
    fontname="DejaVu Sans",
    fontsize=12,
    margin="0.12,0.08"
  ];

  edge [
    color="#374151",
    arrowsize=0.7,
    penwidth=1.4,
    fontname="DejaVu Sans",
    fontsize=10
  ];

  coverage [label="Rewrite\ncoverage", fillcolor="#DBEAFE"];
  dovetail [label="Dovetail\nproofs", fillcolor="#DCFCE7"];
  ast [label="AST artifact\npurity", fillcolor="#FEF3C7"];
  scheduler [label="RSpace schedule\ncorrectness", fillcolor="#FCE7F3"];
  guards [label="Guarded join\ncorrectness", fillcolor="#EDE9FE"];
  extraction [label="Extraction\nhonesty", fillcolor="#CCFBF1"];
  oracle [label="Ascent oracle\nagreement", fillcolor="#FFEDD5"];
  memory [label="Bounded RSS\nstress gate", fillcolor="#FEE2E2"];
  metadata [label="Runtime metadata\nbackend capability", fillcolor="#E0F2FE"];
  flip [label="Flip-gated\nbackend plan", fillcolor="#DCFCE7"];
  production [label="Dovetail/Rho\nproduction runtime", fillcolor="#BBF7D0", penwidth=2.2];

  coverage -> dovetail;
  coverage -> ast;
  dovetail -> extraction;
  ast -> scheduler;
  ast -> guards;
  scheduler -> oracle;
  guards -> oracle;
  extraction -> oracle;
  oracle -> memory;
  memory -> flip;
  flip -> metadata;
  metadata -> production;
  flip -> production;

  subgraph cluster_legend {
    label="Color Key";
    color="#D1D5DB";
    style="rounded,dashed";
    key_coverage [label="coverage", fillcolor="#DBEAFE"];
    key_dovetail [label="Dovetail proofs", fillcolor="#DCFCE7"];
    key_ast [label="AST artifact", fillcolor="#FEF3C7"];
    key_scheduler [label="RSpace schedule", fillcolor="#FCE7F3"];
    key_oracle [label="oracle", fillcolor="#FFEDD5"];
    key_memory [label="bounded resources", fillcolor="#FEE2E2"];
    key_metadata [label="runtime metadata", fillcolor="#E0F2FE"];
    key_prod [label="production runtime", fillcolor="#BBF7D0"];
    key_coverage -> key_dovetail -> key_ast -> key_scheduler -> key_oracle -> key_memory -> key_metadata -> key_prod [style=invis];
  }
}
