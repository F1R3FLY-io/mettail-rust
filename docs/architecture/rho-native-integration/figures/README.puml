@startuml
title Rho-Native MeTTaIL Integration — Component View (actors named by owning crate)

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.4
skinparam component {
  BorderColor #1F2937
  FontColor #111827
}

rectangle "MeTTaIL\nlanguage frontend" as M #DBEAFE {
  component "WPDA parser /\nMeTTaIL recognizer" as Parser #BFDBFE
  component "Typed AST\n(language terms)" as AST #BFDBFE
  component "Language metadata\nbackend capabilities" as Metadata #BFDBFE
  component "Bootstrapped\nRholang model" as RhoModel #93C5FD
}

rectangle "Dovetail rewrite semantics\n`dovetail` + `rigail`" as D #DCFCE7 {
  component "SemanticHash\nexact keys · `key`" as Keys #BBF7D0
  component "E-graph + facts\n`egraph`" as EGraph #BBF7D0
  component "Saturation\nwith outcomes · `rules`" as Saturation #BBF7D0
  component "Checked extraction\nand run report · `extract`" as Report #BBF7D0
}

rectangle "Rho compile-time bridge\n`rholang-codegen`" as B #FEF3C7 {
  component "RhoNet IR" as RhoNet #FDE68A
  component "Guard + native\nhandler classifier" as Guards #FDE68A
  component "rhoapi::Par\nAST builder" as AstBuilder #FDE68A
  component "Flip gate + audit\n(coverage / deadlock)" as Gate #FDE68A
  component "Bytecode-ready\nartifact boundary" as Artifact #CCFBF1
}

rectangle "Rho runtime binding\n(MeTTaIL side)" as R #FBCFE8 {
  component "RhoBackend seam +\ninstallers · `rholang-runtime`" as Seam #FBCFE8
  component "Differential oracle\n(real-vs-real) · `rholang-runtime`" as Oracle #FBCFE8
  component "Direct Dovetail path\n`dovetail-runtime`" as DirectPath #FBCFE8
  component "funding / cost\n`rholang-adapter`" as Cost #FBCFE8
}

rectangle "F1r3node / Rholang\nruntime substrate (external)" as F #FCE7F3 {
  component "RhoRuntime" as Runtime #FBCFE8
  component "RSpace" as RSpace #FBCFE8
  component "COMM scheduler\nand event log" as Scheduler #FBCFE8
  component "Replay + checkpoints" as Replay #FBCFE8
  component "Funding gate" as Funding #FBCFE8
}

rectangle "Verification + rollout\nevidence" as V #EDE9FE {
  component "Formal proof suite" as Formal #DDD6FE
  component "Differential reports" as Diff #DDD6FE
}

Parser --> AST : parsed terms
AST --> Metadata : typed categories
RhoModel --> AST : Rholang as MeTTaIL language
AST --> EGraph : initial facts
Metadata --> Saturation : rule inventory
Keys --> EGraph : exact identity
EGraph --> Saturation : fact base
Saturation --> Report : complete or bounded report
Report --> RhoNet : supported rewrite network
RhoNet --> Guards : join + guard plan
Guards --> AstBuilder : guarded contracts
AstBuilder --> Gate : flip eligibility check
Gate --> Artifact : accepted plan only
Artifact --> Seam : normalized Rholang AST (`Par`)
Report --> DirectPath : RuntimeBackend::Dovetail
Seam --> Runtime : direct AST injection
Runtime --> RSpace : produce / consume / join
RSpace --> Scheduler : enabled COMM events
Scheduler --> RSpace : parallel continuations
Scheduler --> Replay : event log
Cost --> Funding : funding demand / is-funded
RSpace --> Oracle : resting-space facts
Report --> Oracle : Dovetail reference facts
Oracle --> Diff : observed equivalence
Report --> Formal : proof obligations
Formal --> Gate : verified contracts
Diff --> Gate : oracle parity evidence
Gate --> Metadata : Rho backend default eligibility

legend right
|= Area |= Owning crate(s) |
|<#DBEAFE> MeTTaIL | parser, typed terms, metadata |
|<#DCFCE7> Dovetail | `dovetail` + `rigail` |
|<#FEF3C7> Rho compile-time | `rholang-codegen` |
|<#FBCFE8> Rho runtime binding | `rholang-runtime`, `-dovetail-runtime`, `-adapter` |
|<#FCE7F3> F1r3node | RhoRuntime, RSpace, scheduler (external) |
|<#EDE9FE> Evidence | proofs + oracle reports |
endlegend
@enduml
