@startuml
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.3
skinparam componentStyle rectangle
skinparam component {
  BorderColor #1F2937
  FontColor #111827
}
skinparam note {
  BorderColor #1F2937
  FontColor #111827
}

title Theory combination: two ConstraintTheories combine by joint search

' ── Two decidable input theories feeding a joint interleaved search ──
component "arithmetic = PresburgerAlgebra\n(ConstraintTheory, decidable)" as Arith #DBEAFE
component "text = StringAlgebra\n(ConstraintTheory, decidable)" as Text #DBEAFE

' ── The join: joint bounded interleaved search over the shared domain ──
component "arithmetic <+> text\njoint interleaved search (bounded)" as Join #FEF3C7

component "combined ConstraintTheory over Pair" as Combined #DCFCE7
component "TheoryAlgebra → EBA" as EBA #DCFCE7

Arith -down-> Join : factor
Text  -down-> Join : factor
Join     -down-> Combined : yields
Combined -down-> EBA      : adapter

note right of Join #FEF3C7
  Nelson–Oppen **BASE CASE** (joint search over a
  shared domain) — not the full equality-exchange
  procedure.
end note

' ── Formal counterpart (dashed) ──
component "TheoryCombination.v\ncombined_eba_laws · csat_sound · csat_complete" as Formal #E0E7FF
EBA ..> Formal : formal counterpart

legend right
|= Color |= Role |
|<#DBEAFE> | decidable input ConstraintTheory (blue) |
|<#FEF3C7> | joint interleaved bounded search — the combination (amber) |
|<#DCFCE7> | combined theory + the EBA it provides (green) |
|<#E0E7FF> | formal counterpart discharged in Coq (indigo) |
endlegend
@enduml
