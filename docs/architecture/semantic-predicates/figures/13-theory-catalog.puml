@startuml
title Shipped theory capabilities: reject-safe by default, classical only with exactness

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.3
skinparam component {
  BorderColor #1F2937
  FontColor #111827
}
skinparam interface {
  BorderColor #1F2937
  FontColor #111827
}
skinparam note {
  BorderColor #1F2937
  FontColor #111827
}

component "PresburgerTheory\ntotal automata decision" as Presburger #DCFCE7
component "FrozenLatticeTheory\nfinite closed relation" as Frozen #DCFCE7
component "UnificationTheory\npositive-store solver" as Unification #FEF3C7
component "LatticeTheory\nmutable preorder builder" as Lattice #FEF3C7
component "Z3Theory\nSat / Unsat / unknown" as Z3 #FDE68A

interface "ConstraintTheory\npropagate · label · witness · evaluate" as CT #DBEAFE
component "TheoryAlgebra<T>\nbounded, witness-checked search" as Bridge #E0E7FF
interface "RejectSafeAlgebra\nSat | Unsat | DontKnow" as RSA #FEF3C7

interface "DecidableConstraintTheory\ndecide_exact" as DCT #BBF7D0
interface "BooleanAlgebra\nclassical complement" as BA #DBEAFE
component "SFA consumers\nminterms · determinize · inclusion" as SFA #CCFBF1

Presburger --> CT
Frozen --> CT
Unification --> CT
Lattice --> CT
Z3 --> CT
CT --> Bridge
Bridge --> RSA : every theory

Presburger --> DCT
Frozen --> DCT
DCT --> Bridge : exact capability
Bridge --> BA : only when T is decidable
BA --> SFA

Unification ..> DCT #EF4444 : no exact claim
Lattice ..> DCT #EF4444 : freeze first
Z3 ..> DCT #EF4444 : unknown blocks exactness

note bottom of Bridge
  A checked witness may prove satisfiability.
  Search exhaustion alone remains DontKnow.
  Only decide_exact may prove the complementary branch.
end note

legend right
|= Color |= Meaning |
|<#DCFCE7> | exact shipped theory |
|<#FEF3C7> | reject-safe theory |
|<#FDE68A> | external three-valued solver |
|<#E0E7FF> | shared adapter |
|<#DBEAFE> | declared interface |
|<#CCFBF1> | classical automata consumer |
endlegend
@enduml
