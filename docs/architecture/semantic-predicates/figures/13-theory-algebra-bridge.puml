@startuml
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.3
skinparam componentStyle rectangle
skinparam component {
  BorderColor #1F2937
  FontColor #111827
}
skinparam interface {
  BorderColor #1F2937
  FontColor #111827
}
skinparam note {
  BorderColor #1F2937
  FontColor #111827
}

title Capability-gated bridge from constraint theories to symbolic automata

component "theories { name = T for [Cat] }\n(TheoryRegistration)" as Reg #DBEAFE
component "ConstraintTheory T\npropagate · label · witness · evaluate" as Theory #DBEAFE
component "TheoryAlgebra<T> { search_bound }\nbounded fair search + witness recheck" as Adapter #FEF3C7
interface "RejectSafeAlgebra\nis_satisfiable_3v\nSat | Unsat | DontKnow" as RejectSafe #FEF3C7
component "guard pruning · admission\nDontKnow rejects, never refutes" as SafeConsumers #FDE68A

Reg -right-> Theory : lowers to
Theory -right-> Adapter : wrapped by
Adapter -right-> RejectSafe : every T
RejectSafe -right-> SafeConsumers : conservative use

component "DecidableConstraintTheory T\ndecide_exact terminates and is complete" as Decidable #DCFCE7
interface "BooleanAlgebra\nexact SAT · complement · witness" as Boolean #DCFCE7
component "SFA minterms · determinize\ninclusion · equivalence" as ExactConsumers #CCFBF1

Theory -down-> Decidable : additional capability
Decidable -right-> Boolean : same adapter implements
Boolean -right-> ExactConsumers : exact algorithms

note bottom of Adapter
  Bounded search proves Sat only with a rechecked witness.
  Structural contradiction may prove Unsat.
  Search exhaustion without completeness yields DontKnow.
end note

note bottom of Decidable
  Empty label streams, bounded exhaustion, and solver
  silence are not exactness witnesses. The explicit
  decide_exact contract is the classical admission gate.
end note

component "Z3Theory\nConstraintTheory only" as Z3 #FECACA
Z3 -up-> Theory : instance of
Z3 ..> RejectSafe : via TheoryAlgebra<Z3Theory>
Z3 ..> Boolean : forbidden without exact decider

component "ConstraintDecision.v\npositive-witness soundness\ncomplete-refutation requirement" as Formal #E0E7FF
Adapter ..> Formal : mechanized boundary
Decidable ..> Formal : completeness premise

legend right
|= Color |= Role |
|<#DBEAFE> | general registered constraint theory (blue) |
|<#FEF3C7> | bounded three-valued bridge (amber) |
|<#FDE68A> | fail-closed consumers (gold) |
|<#DCFCE7> | exact decidability capability and Boolean bridge (green) |
|<#CCFBF1> | classical symbolic-automata consumers (teal) |
|<#FECACA> | incomplete solver path excluded from classical use (red) |
|<#E0E7FF> | Rocq proof boundary (indigo) |
endlegend
@enduml
