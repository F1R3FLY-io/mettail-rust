@startuml
title The Effective-Boolean-Algebra leaf instances (all exact)

skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle
skinparam shadowing false
skinparam ArrowColor #374151
skinparam ArrowThickness 1.3
skinparam component {
  BorderColor #1F2937
  FontColor #111827
}
skinparam note {
  BorderColor #1F2937
  FontColor #111827
}

' ── Classical, finitely-decidable leaves (blue) ─────────────────────────
component "IntervalAlgebra\ndomain: i64 over [min, max)\nprocedure: normalized half-open ranges\nEXACT (Lemma 5.5)" as Interval #DBEAFE

component "CharClassAlgebra\ndomain: char (Unicode)\nprocedure: u32 range arithmetic\nEXACT (Lemma 5.5)" as CharClass #DBEAFE

component "KatBooleanAlgebra\ndomain: 2^n truth valuations\nprocedure: enumerate 2^n\nEXACT (Lemma 5.6)" as Kat #DBEAFE

' ── Exact-per-domain / regular leaves (green) ───────────────────────────
component "OrderedFieldAlgebra<P>\ndomain: Bound-interval unions over P\nprocedure: witness_in oracle (density-aware)\nEXACT per domain (Theorem 5.7)" as OrderedField #DCFCE7

component "PresburgerAlgebra\ndomain: integer tuples\nprocedure: NFA non-emptiness (no SMT)\nEXACT bounded window (5.1)" as Presburger #DCFCE7

component "StringAlgebra / RegexAlgebra<A>\ndomain: sequences (A::Domain)*\nprocedure: SFA emptiness (Thompson NFA)\nEXACT regular langs (Theorem 5.8)" as Regex #CCFBF1

note bottom of OrderedField
  discrete P (BigInt, i128): open (n, n+1) is EMPTY (successor gap);
  dense P (BigRational, OrderedF64): every non-degenerate interval has a midpoint.
end note

legend right
|= Color |= Group |
|<#DBEAFE> | exact / decidable / classical leaf |
|<#DCFCE7> | exact EBA / regular (exact per domain) |
|<#CCFBF1> | automaton-backed (SFA emptiness) |
endlegend
@enduml
